{
    "name": "cloudcreativity/ddd-modules",
    "description": "Modules for domain-driven implementations in PHP.",
    "keywords": [
        "ddd",
        "domain driven design"
    ],
    "homepage": "https://github.com/cloudcreativity/ddd-modules",
    "support": {
        "issues": "https://github.com/cloudcreativity/ddd-modules/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Cloud Creativity Ltd",
            "email": "info@cloudcreativity.co.uk"
        },
        {
            "name": "Christopher Gammie",
            "email": "chris@cloudcreativity.co.uk"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.7",
        "symfony/polyfill-php85": "^1.33"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "laravel/pint": "^1.32",
        "monolog/monolog": "^3.12",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "files": [
            "src/Toolkit/functions.php"
        ],
        "psr-4": {
            "CloudCreativity\\Modules\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CloudCreativity\\Modules\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "all": [
            "@deptrac",
            "@static",
            "@style",
            "@test"
        ],
        "deptrac": "deptrac analyse --report-uncovered --fail-on-uncovered",
        "static": "phpstan analyse -c phpstan.neon --memory-limit=256M",
        "style": "pint --test",
        "style:fix": "pint",
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "7.x-dev",
            "dev-next": "8.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "policy": {
            "cooldown": {
                "period": "1 day"
            }
        }
    }
}
